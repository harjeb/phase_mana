+#[test]
+fn trigger_oxford_comma_subtype_attacks_unscoped() {
+    let def = parse_trigger_line(
+        "Whenever a Kraken, Leviathan, Merfolk, Octopus, or Serpent attacks, draw a card.",
+        "Summon: Leviathan",
+    );
+    assert_eq!(def.mode, TriggerMode::Attacks);
+    let Some(TargetFilter::Or { filters }) = def.valid_card else {
+        panic!("expected Or target filter for valid_card, got {:?}", def.valid_card);
+    };
+    assert_eq!(filters.len(), 5);
+    let subtypes: Vec<String> = filters
+        .into_iter()
+        .map(|f| match f {
+            TargetFilter::Typed(tf) => {
+                assert_eq!(tf.controller, None, "unscoped trigger must not bind to ControllerRef::You");
+                tf.type_filters
+                    .into_iter()
+                    .find_map(|t| match t {
+                        TypeFilter::Subtype(s) => Some(s),
+                        _ => None,
+                    })
+                    .expect("subtype filter")
+            }
+            other => panic!("expected Typed filter, got {:?}", other),
+        })
+        .collect();
+    assert_eq!(
+        subtypes,
+        vec!["Kraken", "Leviathan", "Merfolk", "Octopus", "Serpent"]
+    );
+    assert!(matches!(def.execute.unwrap().effect.as_ref(), Effect::Draw { .. }));
+}
