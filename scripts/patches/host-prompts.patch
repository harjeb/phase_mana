+/// CR 205.3m + CR 508.1a: Does `text` open with a bare creature subtype IMMEDIATELY
+/// followed by a trigger event head ("serpent attacks", "swamp becomes tapped")?
+///
+/// Used by [`continues_player_action_list`] to keep the final leg of an unscoped
+/// Oxford subtype list inside the trigger CONDITION. Consumes exactly one subtype
+/// via [`parse_subtype`] — deliberately NOT [`parse_type_phrase_folding`], which
+/// would also swallow a trailing "you control" and thereby admit the scoped form
+/// whose boundary is pinned by `condition_side_type_list_boundary_is_unchanged`.
+fn type_word_immediately_followed_by_event_head(text: &str) -> bool {
+    let text = text.trim_start();
+    let text = alt((
+        value((), tag::<_, _, OracleError<'_>>("and/or ")),
+        value((), tag("or ")),
+        value((), tag("and ")),
+    ))
+    .parse(text)
+    .map(|(rest, _)| rest)
+    .unwrap_or(text);
+    let text = alt((tag::<_, _, OracleError<'_>>("a "), tag("an ")))
+        .parse(text)
+        .map(|(rest, _)| rest)
+        .unwrap_or(text);
+    let Some((_, subtype_len)) = parse_subtype(text) else {
+        return false;
+    };
+    let rest = text[subtype_len..].trim_start();
+    match parse_event_head_start(rest) {
