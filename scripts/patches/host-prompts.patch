+#[test]
+fn summon_leviathan_saga_chapters_schedule_attacks_draw() {
+    // CR 205.3m + CR 508.1a + CR 603.7b: Summon: Leviathan's chapters II and III
+    // create an until-end-of-turn delayed "whenever a Kraken, Leviathan, Merfolk,
+    // Octopus, or Serpent attacks, draw a card" trigger. Before the fix the
+    // condition/effect boundary landed at the comma after "Octopus" (the final
+    // "or Serpent attacks" leg had "attacks" read as an effect predicate) and the
+    // trigger parser then produced `TriggerMode::Unknown`, leaving the payload as
+    // `Effect::Unimplemented("unrecognized_clause_head")` — the runtime error
+    // "Cannot play Summon: Leviathan".
+    let parsed = parse_oracle_text(
+        "(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\n\
+I — Return each creature that isn't a Kraken, Leviathan, Merfolk, Octopus, or Serpent to its owner's hand.\n\
+II, III — Until end of turn, whenever a Kraken, Leviathan, Merfolk, Octopus, or Serpent attacks, draw a card.\n\
+Ward {2}",
+        "Summon: Leviathan",
+        &[],
+        &["Enchantment".to_string(), "Creature".to_string()],
+        &["Saga".to_string(), "Leviathan".to_string()],
+    );
+
+    let mut seen = 0;
+    for trigger in &parsed.triggers {
+        let Some(execute) = trigger.execute.as_ref() else {
+            continue;
+        };
+        let Effect::CreateDelayedTrigger {
+            condition: DelayedTriggerCondition::WheneverEvent { trigger: inner, .. },
+            effect,
+            ..
+        } = execute.effect.as_ref()
+        else {
+            continue;
+        };
+        seen += 1;
+        assert_eq!(
+            inner.mode,
+            TriggerMode::Attacks,
+            "inner trigger must be a real Attacks matcher, not Unknown"
+        );
+        let Some(TargetFilter::Or { filters }) = inner.valid_card.as_ref() else {
+            panic!("expected 5-way Or subtype filter, got {:?}", inner.valid_card);
+        };
+        assert_eq!(filters.len(), 5, "one filter per subtype: {filters:?}");
+        assert!(
+            matches!(effect.effect.as_ref(), Effect::Draw { .. }),
+            "the delayed payload must be Draw, not Unimplemented, got {:?}",
+            effect.effect
+        );
+    }
+    assert_eq!(seen, 2, "chapters II and III each schedule the delayed trigger");
+}
