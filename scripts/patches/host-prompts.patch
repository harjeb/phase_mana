+/// CR 205.3m: Split an Oxford comma subtype list (e.g. "Kraken, Leviathan,
+/// Merfolk, Octopus, or Serpent") into individual subtype tokens. Handles
+/// both simple "A or B" and Oxford "A, B, C, or D" forms.
+fn split_oxford_subtype_list(text: &str) -> Vec<&str> {
+    // Split on commas first, then strip leading "or "/"and " from each segment.
+    let mut result = Vec::new();
+    for segment in text.split(',') {
+        let trimmed = segment.trim();
+        if trimmed.is_empty() {
+            continue;
+        }
+        // Strip leading "or " / "and " conjunction from segments after the
+        // first comma (e.g. ", or Serpent" → "Serpent").
+        let word = trimmed
+            .strip_prefix("or ")
+            .or_else(|| trimmed.strip_prefix("and "))
+            .unwrap_or(trimmed)
+            .trim();
+        if !word.is_empty() {
+            result.push(word);
+        }
+    }
+    // Fallback: if there were no commas, split on " or " for the simple
+    // "Samurai or Warrior" form.
+    if result.len() <= 1 {
+        result = text.split(" or ").map(str::trim).filter(|s| !s.is_empty()).collect();
+    }
+    result
+}
